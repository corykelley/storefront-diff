generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Shopify Session (managed by @shopify/shopify-app-session-storage-prisma) ──
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

// ── Shop (convenience table populated via afterAuth hook) ──
model Shop {
  id          String   @id @default(cuid())
  shopDomain  String   @unique
  accessToken String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── DiffRun ──
model DiffRun {
  id                 String       @id @default(cuid())
  shopDomain         String
  baseThemeId        BigInt
  baseThemeName      String
  candidateThemeId   BigInt
  candidateThemeName String
  status             String       @default("queued") // queued | running | complete | failed
  summary            Json? // { added: N, removed: N, modified: N, skipped: N }
  errorMessage       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  assetDiffs         AssetDiff[]
  pageTargets        PageTarget[]
}

// ── ShopSetting ──
model ShopSetting {
  id                      String   @id @default(cuid())
  shopDomain              String   @unique
  storefrontPassword      String?
  hideSelectors           String?  @db.Text // newline-separated CSS selectors
  customUrls              String?  @db.Text // newline-separated paths (e.g. /pages/about)
  navSelector             String?  @db.Text
  interactiveTestsEnabled Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// ── PageTarget ──
model PageTarget {
  id               String            @id @default(cuid())
  diffRunId        String
  diffRun          DiffRun           @relation(fields: [diffRunId], references: [id], onDelete: Cascade)
  pageType         String // "home" | "product" | "collection" | "cart"
  path             String // e.g. "/" or "/products/some-handle"
  handle           String? // resolved handle for product/collection
  status           String            @default("pending") // pending | complete | failed
  errorMessage     String?
  createdAt        DateTime          @default(now())
  screenshots      Screenshot[]
  visualDiffs      VisualDiff[]
  checkResults     CheckResult[]
  interactiveTests InteractiveTest[]

  @@index([diffRunId])
}

// ── Screenshot ──
model Screenshot {
  id           String     @id @default(cuid())
  pageTargetId String
  pageTarget   PageTarget @relation(fields: [pageTargetId], references: [id], onDelete: Cascade)
  variant      String // "base" | "candidate"
  filePath     String // relative to public/, e.g. "runs/{id}/base-home.png"
  width        Int
  height       Int
  createdAt    DateTime   @default(now())

  @@index([pageTargetId])
}

// ── VisualDiff ──
model VisualDiff {
  id              String     @id @default(cuid())
  pageTargetId    String     @unique
  pageTarget      PageTarget @relation(fields: [pageTargetId], references: [id], onDelete: Cascade)
  diffFilePath    String
  mismatchCount   Int
  mismatchPercent Float // 0.0–100.0
  totalPixels     Int // full padded canvas pixels
  effectivePixels Int        @default(0) // overlapping region pixels (used as denominator)
  createdAt       DateTime   @default(now())
}

// ── CheckResult ──
model CheckResult {
  id           String     @id @default(cuid())
  pageTargetId String
  pageTarget   PageTarget @relation(fields: [pageTargetId], references: [id], onDelete: Cascade)
  checkName    String // e.g. "PDP_ATC_PRESENT"
  variant      String // "base" | "candidate"
  passed       Boolean
  selector     String
  detail       String?
  createdAt    DateTime   @default(now())

  @@index([pageTargetId])
}

// ── AssetDiff ──
model AssetDiff {
  id         String   @id @default(cuid())
  diffRunId  String
  diffRun    DiffRun  @relation(fields: [diffRunId], references: [id], onDelete: Cascade)
  key        String // e.g. "templates/index.liquid"
  changeType String // added | removed | modified | large-file-skipped | binary-skipped
  diffText   String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([diffRunId])
}

// ── InteractiveTest ──
model InteractiveTest {
  id             String            @id @default(cuid())
  pageTargetId   String
  pageTarget     PageTarget        @relation(fields: [pageTargetId], references: [id], onDelete: Cascade)
  testName       String // "BUY_FLOW" | "NAVIGATION_SEARCH" | "MOBILE_MENU"
  variant        String // "base" | "candidate"
  status         String // "passed" | "failed" | "error" | "partial"
  steps          InteractiveStep[]
  errorMessage   String?
  totalSteps     Int
  completedSteps Int
  createdAt      DateTime          @default(now())

  @@index([pageTargetId])
}

// ── InteractiveStep ──
model InteractiveStep {
  id                String          @id @default(cuid())
  interactiveTestId String
  interactiveTest   InteractiveTest @relation(fields: [interactiveTestId], references: [id], onDelete: Cascade)
  stepNumber        Int
  action            String // e.g., "click_atc", "verify_cart_count"
  status            String // "success" | "failed" | "skipped"
  selector          String?
  screenshotPath    String?
  errorDetail       String?         @db.Text
  durationMs        Int?
  createdAt         DateTime        @default(now())

  @@index([interactiveTestId])
}
